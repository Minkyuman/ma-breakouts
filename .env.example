GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
AUTH_ALLOWED_EMAILS=
# Comma-separated bootstrap admins for the paper-trading operating console.
# This is separate from AUTH_ALLOWED_EMAILS.
GAME_ADMIN_EMAILS=

# Supabase Postgres transaction-pooler URL. Keep the real value secret.
DATABASE_URL=
CRON_SECRET=
DATABASE_SSL=require

# Server-only OpenRouter configuration for AI stock analysis.
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=qwen/qwen3.8-flash
# Optional comma-separated suggestions shown only to administrators.
OPENROUTER_ANALYSIS_MODEL_SUGGESTIONS=
# Optional contact identifier used only in server-to-server SEC requests.
SEC_API_USER_AGENT=
# Reserved for the Korean primary-filing adapter. Do not expose this key to the browser.
OPENDART_API_KEY=
